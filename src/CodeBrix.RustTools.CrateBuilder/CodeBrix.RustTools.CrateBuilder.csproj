<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.RustTools.CrateBuilder</AssemblyName>
    <RootNamespace>CodeBrix.RustTools.CrateBuilder</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.RustTools.CrateBuilder.MitLicenseForever</PackageId>
    <Product>CodeBrix.RustTools.CrateBuilder</Product>
    <Title>CodeBrix.RustTools.CrateBuilder</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>A .NET library that turns a Rust crate into native binaries and a .NET 10 wrapper class library. It clones the crate from a Git repository with CodeBrix.LibGit2 (or takes a local Cargo.toml), checks first that the machine can build and returns install guidance when it cannot, builds the crate for the chosen runtime identifiers with the installed Rust toolchain or inside a Docker container, optionally links it to the CodeBrix WebGPU engine, generates a C facade for plain Rust libraries from their public API, and writes a .NET 10 wrapper class library (optionally packable as a NuGet package) around the result, together with a JSON build record.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.RustTools</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.RustTools</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>rust;cargo;crate;wrapper;binding;ffi;docker;git;webgpu;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeBrix.RustTools\CodeBrix.RustTools.csproj" />
    <ProjectReference Include="..\CodeBrix.RustTools.Docker\CodeBrix.RustTools.Docker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.LibGit2.MitLicenseForever" Version="1.0.292.267" />
    <PackageReference Include="CodeBrix.Templating.BsdLicenseForever" Version="1.0.284.213" />
    <PackageReference Include="CodeBrix.WebGpu.Native.MitLicenseForever" Version="1.0.290.1433" />
  </ItemGroup>

  <!--
    The manylinux Containerfiles of LinuxBaseline.ManyLinux ship inside the assembly; the Docker
    build driver writes the one it needs into a scratch folder and builds it from there.
  -->
  <ItemGroup>
    <None Remove="Building\ManyLinux\Containerfile.*" />
    <EmbeddedResource Include="Building\ManyLinux\Containerfile.*" LogicalName="CodeBrix.RustTools.CrateBuilder.Building.ManyLinux.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The API extractor tool (Rust source, Cargo.toml, Cargo.lock, SCHEMA.md) is shipped as embedded
    resources and materialised into the scratch folder at run time (Facade/Extraction/ApiExtractorToolSource).
    The logical names are "ApiExtractorTool/<path below Tool/>"; a target/ folder is never embedded.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Facade/Extraction/Tool/**/*" Exclude="Facade/Extraction/Tool/target/**" LogicalName="ApiExtractorTool/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The wrapper writer's Scriban templates (csproj, loader, C# types, README, AGENT-README, notices)
    ship inside the assembly (Wrapper/Rendering/WrapperTemplates).
  -->
  <ItemGroup>
    <None Remove="Wrapper\Templates\*.sbn" />
    <EmbeddedResource Include="Wrapper\Templates\*.sbn" WithCulture="false" LogicalName="CodeBrix.RustTools.CrateBuilder.Wrapper.Templates.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The facade templates (Scriban) ship inside the assembly; FacadeTemplates reads them by the
    logical name "CodeBrix.RustTools.CrateBuilder.Facade.Rendering.Templates.<file name>".
  -->
  <ItemGroup>
    <None Remove="Facade\Rendering\Templates\*.sbn" />
    <EmbeddedResource Include="Facade\Rendering\Templates\*.sbn" WithCulture="false" LogicalName="CodeBrix.RustTools.CrateBuilder.Facade.Rendering.Templates.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The icon and the third-party notices come from the repo root and cover all three packages; the
    README and the agent guide are this package's OWN, living beside this csproj, because the
    root ones describe CodeBrix.RustTools. Files inside the project folder are already part of
    the SDK's default None glob, so they are packed with Update rather than Include.
  -->
  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Update="README.md" Pack="true" PackagePath="" />
    <None Update="AGENT-README.txt" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
