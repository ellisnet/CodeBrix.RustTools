<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Generated by CodeBrix.RustTools.CrateBuilder around the Rust crate {{ model.crate_name }} {{ model.crate_version }}.
    Regenerating the wrapper rewrites the files listed in generated-files.json (and only those).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>{{ model.assembly_name }}</AssemblyName>
    <RootNamespace>{{ model.root_namespace }}</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
{{~ if model.is_packable ~}}
    <IsPackable>true</IsPackable>
{{~ else ~}}
    <IsPackable>false</IsPackable>
{{~ end ~}}
  </PropertyGroup>
{{~ if model.is_packable ~}}

  <!--
    Package / assembly version: date-stamped and auto-incrementing, 1.<x>.<y>.<z> from UTC "now":
    x = whole years since $(_VersionBaseYear), y = day of year (1-based), z = minute of day (0-1439).
    Every build gets a NEW version; two builds in the same UTC minute get the same one. This is
    date-stamp versioning, not SemVer.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>{{ model.packaging.package_id }}</PackageId>
    <Title>{{ model.assembly_name }}</Title>
    <Description>{{ model.packaging.description }}</Description>
    <PackageLicenseExpression>{{ model.packaging.license_expression }}</PackageLicenseExpression>
{{~ if model.packaging.authors ~}}
    <Authors>{{ model.packaging.authors }}</Authors>
{{~ end ~}}
{{~ if model.packaging.project_url ~}}
    <PackageProjectUrl>{{ model.packaging.project_url }}</PackageProjectUrl>
{{~ end ~}}
{{~ if model.packaging.repository_url ~}}
    <RepositoryUrl>{{ model.packaging.repository_url }}</RepositoryUrl>
{{~ end ~}}
{{~ if model.packaging.copyright ~}}
    <Copyright>{{ model.packaging.copyright }}</Copyright>
{{~ end ~}}
{{~ if model.packaging.tags ~}}
    <PackageTags>{{ model.packaging.tags }}</PackageTags>
{{~ end ~}}
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
{{~ end ~}}

  <!--
    The native libraries, one folder per runtime identifier. They are copied to the output folder
    of this project and of every project that references it (runtimes/<rid>/native/, where the
    loader in Native/{{ model.native_class_name }}.cs looks first){{ if model.is_packable }}, and packed under runtimes/ in the
    NuGet package{{ end }}.
  -->
  <ItemGroup>
    <None Update="runtimes/**/*" Pack="true" PackagePath="%(Identity)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
{{~ if model.is_packable ~}}

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="" />
    <None Update="AGENT-README.txt" Pack="true" PackagePath="" />
    <None Update="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Update="WRAP-REPORT.txt" Pack="true" PackagePath="" />
    <None Update="licenses/*" Pack="true" PackagePath="" />
  </ItemGroup>
{{~ end ~}}
{{~ if model.has_smoke_tests ~}}

  <!-- Tests/ holds a smoke-test file to copy into a test project; it is not part of this library. -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
  </ItemGroup>
{{~ end ~}}
{{~ if model.links_web_gpu ~}}

  <!-- The crate links the CodeBrix WebGPU engine (codebrix_wgpu); the loader calls
       CodeBrixWebGpuNative.EnsureLoaded() before it loads the crate's library. -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.WebGpu.Native.MitLicenseForever" Version="{{ model.web_gpu_package_version }}" />
  </ItemGroup>
{{~ end ~}}

</Project>
