/// Status codes, the last-error message, buffers and object boxes shared by every export.
mod facade_support {
    use std::cell::RefCell;

    pub const STATUS_OK: i32 = 0;
    pub const STATUS_NULL_ARGUMENT: i32 = -1;
    pub const STATUS_INVALID_ARGUMENT: i32 = -2;
    pub const STATUS_UPSTREAM_ERROR: i32 = -3;
    pub const STATUS_PANIC: i32 = -4;
    pub const STATUS_HANDLE_CONSUMED: i32 = -5;

    thread_local! {
        static LAST_ERROR: RefCell<String> = const { RefCell::new(String::new()) };
    }

    /// Clears the calling thread's last-error message (every status-returning export starts so).
    pub fn clear_last_error() {
        LAST_ERROR.with(|e| e.borrow_mut().clear());
    }

    /// Stores `message` as the calling thread's last error and returns `status`.
    pub fn fail(status: i32, message: String) -> i32 {
        LAST_ERROR.with(|e| *e.borrow_mut() = message);
        status
    }

    pub fn null_argument(name: &str) -> i32 {
        fail(STATUS_NULL_ARGUMENT, format!("argument '{}' is null", name))
    }

    pub fn invalid_argument(name: &str, why: &str) -> i32 {
        fail(STATUS_INVALID_ARGUMENT, format!("argument '{}' {}", name, why))
    }

    /// Turns a caught panic into STATUS_PANIC with "panic: <message>".
    pub fn panicked(payload: Box<dyn std::any::Any + Send>) -> i32 {
        let text = if let Some(s) = payload.downcast_ref::<&str>() {
            (*s).to_string()
        } else if let Some(s) = payload.downcast_ref::<String>() {
            s.clone()
        } else {
            String::from("(no message)")
        };
        fail(STATUS_PANIC, format!("panic: {}", text))
    }

    /// Copies the calling thread's last-error message (UTF-8, not NUL-terminated) into `buf`.
    pub unsafe fn last_error_message(buf: *mut u8, cap: usize, written: *mut usize) -> i32 {
        if written.is_null() {
            return STATUS_NULL_ARGUMENT;
        }
        LAST_ERROR.with(|e| {
            let e = e.borrow();
            let bytes = e.as_bytes();
            *written = bytes.len();
            if bytes.is_empty() {
                return STATUS_OK;
            }
            if bytes.len() > cap {
                return STATUS_INVALID_ARGUMENT;
            }
            if buf.is_null() {
                return STATUS_NULL_ARGUMENT;
            }
            std::ptr::copy_nonoverlapping(bytes.as_ptr(), buf, bytes.len());
            STATUS_OK
        })
    }

    /// A C bool argument (0 or 1).
    pub fn flag(value: u8, name: &str) -> Result<bool, i32> {
        match value {
            0 => Ok(false),
            1 => Ok(true),
            _ => Err(invalid_argument(name, "must be 0 (false) or 1 (true)")),
        }
    }

    /// A C bool field or value (0 or 1).
    pub fn bool_from(value: u8) -> Result<bool, ()> {
        match value {
            0 => Ok(false),
            1 => Ok(true),
            _ => Err(()),
        }
    }

    fn check_parts<T>(ptr: *const T, len: usize, name: &str) -> Result<(), i32> {
        if ptr.is_null() {
            return Err(null_argument(name));
        }
        match len.checked_mul(std::mem::size_of::<T>()) {
            Some(bytes) if bytes <= isize::MAX as usize => {}
            _ => return Err(invalid_argument(name, "has a length too large for its element type")),
        }
        if (ptr as usize) % std::mem::align_of::<T>() != 0 {
            return Err(invalid_argument(name, "is not aligned for its element type"));
        }
        Ok(())
    }

    /// A read-only slice from pointer + length (the pointer may be null only when the length is 0).
    pub unsafe fn slice<'a, T>(ptr: *const T, len: usize, name: &str) -> Result<&'a [T], i32> {
        if len == 0 {
            return Ok(&[]);
        }
        check_parts(ptr, len, name)?;
        Ok(std::slice::from_raw_parts(ptr, len))
    }

    /// A writable slice from pointer + length (the pointer may be null only when the length is 0).
    pub unsafe fn slice_mut<'a, T>(ptr: *mut T, len: usize, name: &str) -> Result<&'a mut [T], i32> {
        if len == 0 {
            return Ok(&mut []);
        }
        check_parts(ptr as *const T, len, name)?;
        Ok(std::slice::from_raw_parts_mut(ptr, len))
    }

    /// UTF-8 text from pointer + byte length (not NUL-terminated).
    pub unsafe fn utf8<'a>(ptr: *const u8, len: usize, name: &str) -> Result<&'a str, i32> {
        let bytes = slice(ptr, len, name)?;
        std::str::from_utf8(bytes).map_err(|e| invalid_argument(name, &format!("is not valid UTF-8 ({})", e)))
    }

    /// One string of a list of strings passed in: UTF-8 pointer + byte length.
    #[repr(C)]
    #[derive(Clone, Copy)]
    pub struct StrRef {
        pub data: *const u8,
        pub len: usize,
    }

    /// Bytes owned by this library; give them back with free_buffer / free_string.
    /// `len` and `cap` count BYTES; `data` is null when `cap` is 0.
    #[repr(C)]
    pub struct Buffer {
        pub data: *mut u8,
        pub len: usize,
        pub cap: usize,
    }

    impl Buffer {
        pub fn from_vec(bytes: Vec<u8>) -> Buffer {
            if bytes.capacity() == 0 {
                return Buffer { data: std::ptr::null_mut(), len: 0, cap: 0 };
            }
            let mut bytes = std::mem::ManuallyDrop::new(bytes);
            Buffer { data: bytes.as_mut_ptr(), len: bytes.len(), cap: bytes.capacity() }
        }

        pub fn from_string(text: String) -> Buffer {
            Buffer::from_vec(text.into_bytes())
        }

        /// Numbers as their native-endian bytes (released as bytes, like every Buffer).
        pub fn from_elements<T: Copy>(items: Vec<T>) -> Buffer {
            let bytes = unsafe { std::slice::from_raw_parts(items.as_ptr() as *const u8, items.len() * std::mem::size_of::<T>()) }.to_vec();
            Buffer::from_vec(bytes)
        }

        /// A list of buffers (strings) as the bytes of their Buffer structs: the caller
        /// releases the outer buffer with free_buffer and every inner one with free_string.
        /// Buffer has no Drop, so the copies in the outer buffer are the only owners.
        pub fn from_buffers(items: Vec<Buffer>) -> Buffer {
            let items = std::mem::ManuallyDrop::new(items);
            let bytes = unsafe { std::slice::from_raw_parts(items.as_ptr() as *const u8, items.len() * std::mem::size_of::<Buffer>()) }.to_vec();
            unsafe { drop(Vec::from_raw_parts(items.as_ptr() as *mut Buffer, 0, items.capacity())) };
            Buffer::from_vec(bytes)
        }
    }

    pub unsafe fn release_buffer(buffer: Buffer) {
        if !buffer.data.is_null() {
            drop(Vec::from_raw_parts(buffer.data, buffer.len, buffer.cap));
        }
    }

    /// The box behind every object pointer: the upstream value (gone once a consuming method
    /// used it) and whether a call on it panicked.
    pub struct HandleBox<T> {
        inner: Option<T>,
        broken: bool,
    }

    impl<T> HandleBox<T> {
        pub fn boxed(value: T) -> *mut HandleBox<T> {
            Box::into_raw(Box::new(HandleBox { inner: Some(value), broken: false }))
        }
    }

    fn unusable(name: &str, broken: bool) -> i32 {
        if broken {
            fail(STATUS_PANIC, format!("argument '{}' is an object whose earlier call panicked; it can only be destroyed", name))
        } else {
            fail(STATUS_HANDLE_CONSUMED, format!("argument '{}' is an object a consuming method has already used up; it can only be destroyed", name))
        }
    }

    pub unsafe fn handle_ref<'a, T>(handle: *mut HandleBox<T>, name: &str) -> Result<&'a T, i32> {
        if handle.is_null() {
            return Err(null_argument(name));
        }
        let b = &*handle;
        if b.broken {
            return Err(unusable(name, true));
        }
        b.inner.as_ref().ok_or_else(|| unusable(name, false))
    }

    pub unsafe fn handle_mut<'a, T>(handle: *mut HandleBox<T>, name: &str) -> Result<&'a mut T, i32> {
        if handle.is_null() {
            return Err(null_argument(name));
        }
        let b = &mut *handle;
        if b.broken {
            return Err(unusable(name, true));
        }
        b.inner.as_mut().ok_or_else(|| unusable(name, false))
    }

    pub unsafe fn handle_take<T>(handle: *mut HandleBox<T>, name: &str) -> Result<T, i32> {
        if handle.is_null() {
            return Err(null_argument(name));
        }
        let b = &mut *handle;
        if b.broken {
            return Err(unusable(name, true));
        }
        b.inner.take().ok_or_else(|| unusable(name, false))
    }

    pub unsafe fn poison<T>(handle: *mut HandleBox<T>) {
        if !handle.is_null() {
            (*handle).broken = true;
        }
    }

    /// Error text: Display when the error type has it, else Debug (autoref selection).
    pub struct ErrText<'a, T: ?Sized>(pub &'a T);

    pub trait ViaDisplay {
        fn error_text(&self) -> String;
    }

    impl<T: ?Sized + std::fmt::Display> ViaDisplay for ErrText<'_, T> {
        fn error_text(&self) -> String {
            self.0.to_string()
        }
    }

    pub trait ViaDebug {
        fn error_text(&self) -> String;
    }

    impl<T: ?Sized + std::fmt::Debug> ViaDebug for &ErrText<'_, T> {
        fn error_text(&self) -> String {
            format!("{:?}", self.0)
        }
    }
}

