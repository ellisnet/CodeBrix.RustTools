# Generated by CodeBrix.RustTools.CrateBuilder (FacadeRenderer): the C facade crate of
# {{ package_name }} {{ version }}. Do not edit by hand: a re-render replaces this file.
# See FACADE-README.txt.

[package]
name = "{{ facade_crate_name }}"
version = "{{ version }}"
edition = "2024"
publish = false
{{~ if link_to_web_gpu ~}}
build = "build.rs"
{{~ end ~}}

# The library is named after the upstream crate, so the built file is lib{{ lib_name }}.so /
# lib{{ lib_name }}.dylib / {{ lib_name }}.dll and the .NET wrapper loads "{{ lib_name }}".
[lib]
name = "{{ lib_name }}"
path = "src/lib.rs"
crate-type = ["cdylib"]

# The upstream crate, untouched, by path.
[dependencies]
upstream = {{ upstream_dependency }}
{{ workspace_patches }}
# An empty workspace table makes this folder its own workspace root. The facade sits inside the
# staged upstream tree; without this table cargo would look for an enclosing workspace and
# refuse to build a package that is not one of its members.
[workspace]

{{ workspace_profiles }}
